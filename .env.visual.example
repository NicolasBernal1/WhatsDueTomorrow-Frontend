# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — REGRESIÓN VISUAL CON ARGOS CI, PLAYWRIGHT & IA (MCP)
# Copie este archivo como .env.visual y reemplace con sus valores reales.
# ==============================================================================
# 1. Personal Access Token (PAT) de Argos CI
# Requerido por el servidor MCP (https://mcp.argos-ci.com/) y el Agente de IA.
# Generado en https://app.argos-ci.com/ -> Perfil -> Personal Access Tokens.
ARGOS_PAT=arp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Token de Proyecto (Project Token) de Argos CI
# Requerido por 'argos upload ./screenshots' y GitHub Actions / Jenkins.
# Obtenido en: https://app.argos-ci.com/<owner>/<project>/settings
ARGOS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. URL base de la aplicación Angular local
BASE_URL=http://127.0.0.1:4200

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
<meta content="text/html; charset=UTF-8" http-equiv="content-type" />
<title>F01 Registro con correo ya usado</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">Untitled Test Case</td></tr>
</thead>
<tbody>
<tr><td>storeEval</td><td>localStorage.clear()<datalist><option>localStorage.clear()</option></datalist></td><td></td></tr>
<tr><td>open</td><td>http://localhost:4200/register<datalist><option>http://localhost:4200/register</option></datalist></td><td></td></tr>
<tr><td>type</td><td>css=mat-card.register-card input[type='text']<datalist><option>css=mat-card.register-card input[type='text']</option></datalist></td><td>Ana Pérez</td></tr>
<tr><td>type</td><td>css=mat-card.register-card input[type='email']<datalist><option>css=mat-card.register-card input[type='email']</option></datalist></td><td>${email}</td></tr>
<tr><td>type</td><td>css=mat-card.register-card input[type='password']<datalist><option>css=mat-card.register-card input[type='password']</option></datalist></td><td>${pass}</td></tr>
<tr><td>click</td><td>css=mat-card button[type='submit']<datalist><option>css=mat-card button[type='submit']</option></datalist></td><td></td></tr>
<tr><td>assertAlert</td><td>This email is already in use<datalist><option>This email is already in use</option></datalist></td><td></td></tr>
<tr><td>assertLocation</td><td>regexp:.*/register$<datalist><option>regexp:.*/register$</option></datalist></td><td></td></tr>
</tbody></table>
</body>
</html>
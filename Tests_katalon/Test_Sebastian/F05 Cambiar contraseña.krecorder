<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
<meta content="text/html; charset=UTF-8" http-equiv="content-type" />
<title>F05 Cambiar contraseña</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">Untitled Test Case</td></tr>
</thead>
<tbody>
<tr><td>store</td><td>Nueva456<datalist><option>Nueva456</option></datalist></td><td>newpass</td></tr>
<tr><td>click</td><td>xpath=//mat-toolbar/button[contains(normalize-space(.),'Profile')]<datalist><option>xpath=//mat-toolbar/button[contains(normalize-space(.),'Profile')]</option></datalist></td><td></td></tr>
<tr><td>type</td><td>css=.password-section input[type='password']<datalist><option>css=.password-section input[type='password']</option></datalist></td><td>${pass}</td></tr>
<tr><td>click</td><td>css=.password-section button<datalist><option>css=.password-section button</option></datalist></td><td></td></tr>
<tr><td>pause</td><td>2000<datalist><option>2000</option></datalist></td><td></td></tr>
<tr><td>assertElementPresent</td><td>css=.password-section .verified-message<datalist><option>ss=.password-section .verified-message</option><option>css=.password-section .verified-message</option></datalist></td><td></td></tr>
<tr><td>type</td><td>css=.password-section input[type='password']<datalist><option>css=.password-section input[type='password']</option></datalist></td><td>${newpass}</td></tr>
<tr><td>click</td><td>css=.password-section button<datalist><option>css=.password-section button</option></datalist></td><td></td></tr>
<tr><td>pause</td><td>3000<datalist><option>3000</option></datalist></td><td></td></tr>
<tr><td>assertLocation</td><td>regexp:.*/login$<datalist><option></option><option>regexp:.*/login$</option></datalist></td><td></td></tr>
<tr><td>assertEval</td><td>localStorage.getItem('token') === null<datalist><option></option><option>localStorage.getItem('token') === null</option></datalist></td><td>true</td></tr>
<tr><td>store</td><td>${newpass}<datalist><option>${newpass}</option></datalist></td><td>pass</td></tr>
</tbody></table>
</body>
</html>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
<meta content="text/html; charset=UTF-8" http-equiv="content-type" />
<title>F05 Contraseña actual incorrecta</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">Untitled Test Case</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>http://localhost:4200/login<datalist><option>http://localhost:4200/login</option></datalist></td><td></td></tr>
<tr><td>type</td><td>css=mat-card.login-card input[type='email']<datalist><option>css=mat-card.login-card input[type='email']</option></datalist></td><td>${email}</td></tr>
<tr><td>type</td><td>css=mat-card.login-card input[type='password']<datalist><option>css=mat-card.login-card input[type='password']</option></datalist></td><td>{pass}</td></tr>
<tr><td>clickAndWait</td><td>css=mat-card button[type='submit']<datalist><option>css=mat-card button[type='submit']</option></datalist></td><td></td></tr>
<tr><td>pause</td><td>3000<datalist><option>3000</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//mat-toolbar/button[contains(normalize-space(.),'Profile')]<datalist><option>xpath=//mat-toolbar/button[contains(normalize-space(.),'Profile')]</option></datalist></td><td></td></tr>
<tr><td>type</td><td>css=.password-section input[type='password']<datalist><option></option><option>css=.password-section input[type='password']</option></datalist></td><td>	Incorrecta999</td></tr>
<tr><td>click</td><td>css=.password-section button<datalist><option></option><option>css=.password-section button</option></datalist></td><td></td></tr>
<tr><td>pause</td><td>2000<datalist><option></option><option>2000</option></datalist></td><td></td></tr>
<tr><td>verifyText</td><td>	css=.password-section .error-message<datalist><option>	css=.password-section .error-message</option></datalist></td><td>regexp:.*Incorrect password.*</td></tr>
</tbody></table>
</body>
</html>
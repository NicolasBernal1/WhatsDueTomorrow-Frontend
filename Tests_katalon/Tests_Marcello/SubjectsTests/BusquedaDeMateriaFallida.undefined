<?xml version="1.0" encoding="UTF-8"?>
<TestCase>
<selenese>
	<command>open</command>
	<target><![CDATA[https://whats-due-tomorrow-frontend.vercel.app/subjects]]></target>
	<value><![CDATA[]]></value>
</selenese>
<selenese>
	<command>click</command>
	<target><![CDATA[id=subject-search]]></target>
	<value><![CDATA[]]></value>
</selenese>
<selenese>
	<command>type</command>
	<target><![CDATA[id=subject-search]]></target>
	<value><![CDATA[Fisica]]></value>
</selenese>
<selenese>
	<command>waitForElementPresent</command>
	<target><![CDATA[xpath=//*[contains(normalize-space(),'You have no subjects yet')]]]></target>
	<value><![CDATA[20000]]></value>
</selenese>
<selenese>
	<command>assertElementPresent</command>
	<target><![CDATA[xpath=//*[contains(normalize-space(),'You have no subjects yet')]]]></target>
	<value><![CDATA[]]></value>
</selenese>
<selenese>
	<command>assertText</command>
	<target><![CDATA[xpath=//*[contains(normalize-space(),'You have no subjects yet')]]]></target>
	<value><![CDATA[glob:*You have no subjects yet*]]></value>
</selenese>
</TestCase>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
<meta content="text/html; charset=UTF-8" http-equiv="content-type" />
<title>WDT_Visualizar horario</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">TC_Visualizar-horario</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://whats-due-tomorrow-frontend.vercel.app/schedule<datalist><option>https://whats-due-tomorrow-frontend.vercel.app/schedule</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>class=class-card<datalist><option>class=class-card</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>class=class-name<datalist><option>class=class-name</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>class=class-professor<datalist><option>class=class-professor</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>class=class-time<datalist><option>class=class-time</option></datalist></td><td></td></tr>
<tr><td>assertText</td><td>class=class-name<datalist><option>class=class-name</option></datalist></td><td>Validacion</td></tr>
<tr><td>assertText</td><td>class=class-professor<datalist><option>class=class-professor</option></datalist></td><td>Gabriel</td></tr>
<tr><td>assertText</td><td>class=class-time<datalist><option>class=class-time</option></datalist></td><td>08:00:00 - 10:00:00</td></tr>
</tbody></table>
</body>
</html>
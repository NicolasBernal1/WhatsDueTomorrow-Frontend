# Proveedor usado por test:observe: ollama, openai o gemini.
AI_PROVIDER=ollama

# Navegador local. CHROME_PATH es opcional si Chrome se detecta automáticamente.
HEADLESS=false
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
STAGEHAND_LOG_LEVEL=info

# Ollama local: no necesita una clave externa.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b

# OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4.1-mini

# Google Gemini.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=google/gemini-2.5-flash

# App bajo prueba
APP_URL=https://whats-due-tomorrow-frontend.vercel.app
API_URL=https://whatsduetomorrow-backed.onrender.com

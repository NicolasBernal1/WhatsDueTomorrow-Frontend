{
  "name": "whats-due-tomorrow-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test --no-watch --no-progress --browsers=ChromeHeadless --exclude **/*.regression.spec.ts",
    "test:regression": "ng test --no-watch --no-progress --browsers=ChromeHeadless --include **/*.regression.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:seed": "playwright test test/seed.spec.ts",
    "test:e2e:agents": "playwright test test/e2e/",
    "test:e2e:heal": "playwright test test/e2e/ --trace=on",
    "cypress:open": "cypress open --browser chrome",
    "cypress:run": "cypress run --browser chrome",
    "test:cy:f21": "cypress run --browser chrome --headed --spec \"cypress/e2e/f21-urgent-radar/**/*.cy.ts\"",
    "test:cy:f21:headless": "cypress run --browser chrome --spec \"cypress/e2e/f21-urgent-radar/**/*.cy.ts\"",
    "test:cy:f22": "cypress run --browser chrome --headed --spec \"cypress/e2e/f22-subtasks/**/*.cy.ts\"",
    "test:cy:f23": "cypress run --browser chrome --headed --spec \"cypress/e2e/f23-calendar/**/*.cy.ts\"",
    "test:cy:f24": "cypress run --browser chrome --headed --spec \"cypress/e2e/f24-notes/**/*.cy.ts\"",
    "test:cy:f25": "cypress run --browser chrome --headed --spec \"cypress/e2e/f25-evaluations/**/*.cy.ts\"",
    "test:cy:f26": "cypress run --browser chrome --headed --spec \"cypress/e2e/f26-academic-load/**/*.cy.ts\"",
    "test:cy:marcello": "cypress run --browser chrome --config-file cypress.marcello.config.ts",
    "test:cy:marcello:ui": "cypress run --browser chrome --config-file cypress.marcello.config.ts --spec \"cypress_marcello/e2e/ui/**/*.cy.ts\"",
    "test:cy:marcello:api": "cypress run --browser chrome --config-file cypress.marcello.config.ts --spec \"cypress_marcello/e2e/api/**/*.cy.ts\"",
    "test:cy:marcello:security": "cypress run --browser chrome --config-file cypress.marcello.config.ts --spec \"cypress_marcello/e2e/security/**/*.cy.ts\"",
    "test:cy:marcello:a11y": "cypress run --browser chrome --config-file cypress.marcello.config.ts --spec \"cypress_marcello/e2e/accessibility/**/*.cy.ts\"",
    "test:cy:marcello:perf": "cypress run --browser chrome --config-file cypress.marcello.config.ts --spec \"cypress_marcello/e2e/performance/**/*.cy.ts\"",
    "test:cy:marcello:regression": "cypress run --browser chrome --config-file cypress.marcello.config.ts --spec \"cypress_marcello/e2e/regression/**/*.cy.ts\"",
    "test:cy:marcello:unit": "cypress run --component --browser chrome --config-file cypress.marcello.config.ts",
    "cypress:marcello:open": "cypress open --browser chrome --config-file cypress.marcello.config.ts",
    "test:bdd": "npm --prefix tests-bdd run test",
    "test:bdd:f21": "npm --prefix tests-bdd run test:bdd:f21",
    "test:bdd:f22": "npm --prefix tests-bdd run test:bdd:f22",
    "test:bdd:f23": "npm --prefix tests-bdd run test:bdd:f23",
    "test:bdd:f24": "npm --prefix tests-bdd run test:bdd:f24",
    "test:bdd:f25": "npm --prefix tests-bdd run test:bdd:f25",
    "test:bdd:f26": "npm --prefix tests-bdd run test:bdd:f26",
    "test:bdd:all": "npm --prefix tests-bdd run test:bdd:all",
    "test:bdd:report": "npm --prefix tests-bdd run test:bdd:report",
    "test:cy:sebastian": "cypress run --browser chrome --config-file cypress.sebastian.config.ts --spec \"cypress_sebastian/e2e/**/*.cy.ts\"",
    "test:cy:sebastian:e2e": "npm run test:cy:sebastian",
    "test:cy:sebastian:ui": "cypress run --browser chrome --config-file cypress.sebastian.config.ts --spec \"cypress_sebastian/e2e/ui/**/*.cy.ts\"",
    "test:cy:sebastian:api": "cypress run --browser chrome --config-file cypress.sebastian.config.ts --spec \"cypress_sebastian/e2e/api/**/*.cy.ts\"",
    "test:cy:sebastian:security": "cypress run --browser chrome --config-file cypress.sebastian.config.ts --spec \"cypress_sebastian/e2e/security/**/*.cy.ts\"",
    "test:cy:sebastian:a11y": "cypress run --browser chrome --config-file cypress.sebastian.config.ts --spec \"cypress_sebastian/e2e/accessibility/**/*.cy.ts\"",
    "test:cy:sebastian:perf": "cypress run --browser chrome --config-file cypress.sebastian.config.ts --spec \"cypress_sebastian/e2e/performance/**/*.cy.ts\"",
    "test:cy:sebastian:regression": "cypress run --browser chrome --config-file cypress.sebastian.config.ts --spec \"cypress_sebastian/e2e/regression/**/*.cy.ts\"",
    "test:cy:sebastian:unit": "cypress run --component --browser chrome --config-file cypress.sebastian.config.ts",
    "cypress:sebastian:open": "cypress open --browser chrome --config-file cypress.sebastian.config.ts",
    "test:cy:nicolas": "cypress run --browser chrome --config-file cypress.nicolas.config.ts",
    "test:cy:nicolas:regression": "cypress run --browser chrome --config-file cypress.nicolas.config.ts --spec \"cypress_nicolas/e2e/regression/**/*.cy.ts\"",
    "test:cy:nicolas:ui": "cypress run --browser chrome --config-file cypress.nicolas.config.ts --spec \"cypress_nicolas/e2e/ui/**/*.cy.ts\"",
    "test:cy:nicolas:security": "cypress run --browser chrome --config-file cypress.nicolas.config.ts --spec \"cypress_nicolas/e2e/security/**/*.cy.ts\"",
    "test:cy:nicolas:a11y": "cypress run --browser chrome --config-file cypress.nicolas.config.ts --spec \"cypress_nicolas/e2e/accessibility/**/*.cy.ts\"",
    "test:cy:nicolas:perf": "cypress run --browser chrome --config-file cypress.nicolas.config.ts --spec \"cypress_nicolas/e2e/performance/**/*.cy.ts\"",
    "test:cy:nicolas:unit": "cypress run --component --browser chrome --config-file cypress.nicolas.config.ts",
    "cypress:nicolas:open": "cypress open --browser chrome --config-file cypress.nicolas.config.ts",
    "test:stagehand": "npm --prefix tests-stagehand run test",
    "test:stagehand:warmup": "npm --prefix tests-stagehand run test:warmup",
    "test:stagehand:f21": "npm --prefix tests-stagehand run test:f21",
    "test:stagehand:f22": "npm --prefix tests-stagehand run test:f22",
    "test:stagehand:f23": "npm --prefix tests-stagehand run test:f23",
    "test:stagehand:f24": "npm --prefix tests-stagehand run test:f24",
    "test:stagehand:f25": "npm --prefix tests-stagehand run test:f25",
    "test:stagehand:f26": "npm --prefix tests-stagehand run test:f26",
    "test:stagehand:all": "npm --prefix tests-stagehand run test:all",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:headed": "playwright test --config=playwright.visual.config.ts --headed",
    "test:visual:upload": "argos upload ./screenshots",
    "test:visual:ci": "npm run test:visual && npm run test:visual:upload",
    "test:visual:ai-inspect": "node --no-warnings --experimental-strip-types test/visual/ai-inspector/argos-ai-inspector.ts",
    "test:visual:mcp-check": "node --no-warnings --experimental-strip-types test/visual/ai-inspector/argos-mcp-client.ts",
    "test:api:postman": "npm --prefix ../WhatsDueTomorrow-Backed run test:postman:render",
    "test:api:postman:all": "npm --prefix ../WhatsDueTomorrow-Backed run test:postman:render"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.0",
    "@argos-ci/cli": "^6.11.0",
    "@argos-ci/playwright": "^7.8.0",
    "@playwright/test": "^1.62.1",
    "@reportportal/agent-js-cypress": "^5.5.4",
    "@types/chai": "^4.3.20",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "axe-core": "^4.14.0",
    "chai": "^4.5.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "cypress-slow-down": "^1.4.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2"
  }
}
# URLs base del despliegue en producción
FRONTEND_BASE_URL=https://whats-due-tomorrow-frontend.vercel.app
BACKEND_BASE_URL=https://whatsduetomorrow-backed.onrender.com

# Proveedor de IA predeterminado: gemini, openai u ollama
AI_PROVIDER=gemini

# Configuración de navegador local (false para ventana visible en Chrome)
HEADLESS=false
CHROME_PATH=/home/dsanabriag/.local/bin/google-chrome
STAGEHAND_LOG_LEVEL=info

# Google Gemini (recomendado para CI/CD y evaluaciones)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=google/gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4.1-mini

# Ollama local (opcional)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b
